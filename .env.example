# Application Logging Level
LOGLEVEL=info

# MQTT Configuration
MQTTHOST=mqtt://your_mqtt_host
MQTTPORT=1886
MQTTUSER=your_mqtt_username
MQTTPASSWORD=your_mqtt_password

# MQTT Topics
PUBLISHTOPIC=telenot/alarm
COMMANDTOPIC=telenot/alarm/command
STATETOPIC=telenot/alarm/state
USE_JSON_PAYLOAD=true

# Telnet Configuration
TELNETHOST=your_telnet_host
TELNETPORT=8234

# Panel address (hex) of the state 'disarmed' of area 1. complex 400H: 530 (default).
# hiplex 8400H: 500. See HIPLEX-8400H.md.
# AREA_STATE_ADDRESS=530

# Set to false to refuse every arm/disarm command to the panel (default true)
# COMMANDS_ENABLED=true

# Health check: maximum age in seconds of the last panel frame (default 120)
# HEARTBEAT_MAX_AGE=120

# Alarm panel entity in Home Assistant, published by the bridge
# ALARM_PANEL_DISCOVERY=true
# ALARM_PANEL_FEATURES=arm_home,arm_away,arm_night
# ALARM_PANEL_DEVICE_NAME=Telenot
# ALARM_PANEL_DEVICE_MODEL=Telenot Alarm System
# Code for DISARM, checked by the bridge (keep it out of version control)
# ALARM_CODE=
# Exit delay in seconds before an internal arm command is sent (default 0)
# ARM_HOME_DELAY=30
# ALARM_RESET_BUTTON=true

# Discovery Configuration
DISCOVER=true

# Node Environment
NODE_ENV=production

# Homeassistant sensor autodiscovery
HOMEASSISTANT_AUTODISCOVERY=false

# Telenot Discovery
TELENOT_DISCOVERY=false

# Set Timezone
TZ=Europe/Berlin
